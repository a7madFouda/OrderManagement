@model PagedResult<OrderDto>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-light border">No orders found.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Products</th>
                <th>Discount</th>
                <th class="text-end">Subtotal</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Items)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.Customer.Name</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@string.Join(", ", order.Items.Select(item => $"{item.ProductName} × {item.Quantity}"))</td>
                    <td>@DiscountText(order)</td>
                    <td class="text-end">@order.SubTotal.ToString("N2")</td>
                    <td class="text-end fw-semibold">@order.Total.ToString("N2")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@order.Id">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-delete-order="@order.Id">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@Model.TotalCount order(s)</span>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Orders pages">
                <ul class="pagination pagination-sm mb-0">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page ? "active" : null)">
                            <button type="button" class="page-link" data-page="@pageNumber">@pageNumber</button>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
}

@functions {
    private static string DiscountText(OrderDto order) => order.DiscountType switch
    {
        DiscountType.Percentage => $"{order.DiscountValue:0.##}% (-{order.DiscountAmount:N2})",
        DiscountType.FixedAmount => $"-{order.DiscountAmount:N2}",
        _ => "—"
    };
}
