<h2 class="h5">Items</h2>
<table class="table align-middle">
    <thead class="table-light">
        <tr>
            <th>Product</th>
            <th class="col-quantity">Quantity</th>
            <th class="col-price">Unit price</th>
            <th class="col-price text-end">Line total</th>
            <th class="col-action"></th>
        </tr>
    </thead>
    <tbody id="item-rows"></tbody>
</table>
<button type="button" id="add-item" class="btn btn-outline-primary btn-sm mb-4">+ Add item</button>

<div class="row g-4">
    <div class="col-md-6">
        <h2 class="h5">Discount</h2>
        <div class="row g-2">
            <div class="col-sm-6">
                <select id="discountType" name="discountType" class="form-select">
                    <option value="None">No discount</option>
                    <option value="Percentage">Percentage (%)</option>
                    <option value="FixedAmount">Fixed amount</option>
                </select>
            </div>
            <div class="col-sm-6">
                <input id="discountValue" name="discountValue" type="number" class="form-control"
                       min="0.01" step="0.01" placeholder="Value" disabled />
                <div class="invalid-feedback">Enter a discount value greater than 0.</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <h2 class="h5">Summary</h2>
        <dl class="row mb-0">
            <dt class="col-6">Subtotal</dt>
            <dd class="col-6 text-end" id="summary-subtotal">0.00</dd>
            <dt class="col-6">Discount</dt>
            <dd class="col-6 text-end" id="summary-discount">0.00</dd>
            <dt class="col-6">Total</dt>
            <dd class="col-6 text-end fw-bold" id="summary-total">0.00</dd>
        </dl>
    </div>
</div>

<template id="item-row-template">
    <tr>
        <td>
            <input name="productName" class="form-control" placeholder="Product name" required maxlength="200" />
            <div class="invalid-feedback">Product name is required.</div>
        </td>
        <td>
            <input name="quantity" type="number" class="form-control" value="1" required min="1" step="1" />
            <div class="invalid-feedback">Must be at least 1.</div>
        </td>
        <td>
            <input name="unitPrice" type="number" class="form-control" placeholder="0.00" required min="0.01" step="0.01" />
            <div class="invalid-feedback">Must be greater than 0.</div>
        </td>
        <td class="text-end" data-line-total>0.00</td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-outline-danger" data-remove-item aria-label="Remove item">&times;</button>
        </td>
    </tr>
</template>
